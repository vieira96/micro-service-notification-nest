{
  "info": {
    "_postman_id": "987aa1be-4e04-48ae-a49c-8a93d3d5d3f1",
    "name": "Notification API",
    "description": "Collection do microserviço de notificações. Informe {{accessToken}} com o access token obtido no login da Library API. O usuário é identificado pelo sub do JWT; não existe userId na query string.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "notificationApiUrl",
      "value": "http://localhost:8001",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "notificationId",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Notifications",
      "item": [
        {
          "name": "List notifications",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns a page', () => { const body = pm.response.json(); pm.expect(body).to.have.property('content'); pm.expect(body.content).to.be.an('array'); });",
                  "const first = pm.response.json().content[0];",
                  "pm.test('Item has read state', () => { if (first) pm.expect(first).to.have.property('read'); });",
                  "if (first) pm.collectionVariables.set('notificationId', first.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{notificationApiUrl}}/notifications?page=1&size=10",
            "description": "Lista paginada (page, size) com o estado de leitura (read/readAt) do usuário presente no sub do JWT."
          }
        },
        {
          "name": "Unread count",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns a count', () => pm.expect(pm.response.json()).to.have.property('count'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{notificationApiUrl}}/notifications/unread-count",
            "description": "Quantidade de não lidas do usuário do JWT. O sino consome este endpoint."
          }
        },
        {
          "name": "Mark all as read",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "url": "{{notificationApiUrl}}/notifications/read-all",
            "description": "Marca todas as notificações como lidas para o usuário do JWT."
          }
        },
        {
          "name": "Mark notification as read",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "url": "{{notificationApiUrl}}/notifications/{{notificationId}}/read",
            "description": "Execute List notifications antes; ela preenche notificationId automaticamente quando houver resultado."
          }
        }
      ]
    }
  ]
}
