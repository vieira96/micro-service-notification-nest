// Domínio do módulo de notificações.
// Notification é única e sem dono (sem userId).
// O estado por usuário (leu/não leu) vive em notification-read.prisma.

enum NotificationChannel {
  IN_APP
  PUSH
  EMAIL
  SMS
}

model Notification {
  id        String              @id @default(uuid())
  type      String              @db.VarChar(50)
  title     String              @db.VarChar(200)
  message   String              @db.Text
  data      Json?
  channel   NotificationChannel @default(IN_APP)
  // Destino opcional ao clicar. external=false navega no SPA; true abre nova aba.
  url       String?             @db.VarChar(500)
  external  Boolean             @default(false)
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")

  reads NotificationRead[]

  @@index([createdAt(sort: Desc)])
  @@map("notifications")
}
