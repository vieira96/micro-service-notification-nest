// Domínio do módulo de notificações.
// Notification é única e sem dono (sem userId).
// O estado por usuário (leu/não leu) vive em notification-read.prisma.

enum NotificationChannel {
  IN_APP
  PUSH
  EMAIL
  SMS
}

model Notification {
  id        String              @id @default(uuid())
  type      String              @db.VarChar(50)
  eventKey  String              @unique @map("event_key") @db.VarChar(120)
  title     String              @db.VarChar(200)
  message   String              @db.Text
  data      Json?
  channels  NotificationChannel[] @default([IN_APP])
  // Destino opcional ao clicar. path=navegação interna (routerLink); url=redirect externo.
  path      String?             @db.VarChar(500)
  url       String?             @db.VarChar(500)
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")

  reads NotificationRead[]

  @@index([createdAt(sort: Desc)])
  @@map("notifications")
}
