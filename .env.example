# Copie para .env e ajuste os segredos locais. Nunca versione o .env real.

# Banco dedicado do microservice (container `postgres` no docker-compose).
# Dentro do Docker o host é `postgres`; fora do Docker use localhost:${POSTGRES_PORT}.
DATABASE_URL="postgresql://notifications:notifications@postgres:5432/notifications?schema=public"

# API Nest (lida por src/main.ts via process.env.PORT)
PORT=8001

# Redis próprio do microservice (pub/sub para escalar o realtime).
# Dentro do Docker o host é `redis`; fora do Docker use localhost:6380.
REDIS_HOST=redis
REDIS_PORT=6379

# Postgres (usado pelo docker-compose para criar o banco).
# POSTGRES_PORT é a porta publicada no host (5432 já é da libraryapi).
POSTGRES_DB=notifications
POSTGRES_USER=notifications
POSTGRES_PASSWORD=notifications
POSTGRES_PORT=5433

# RabbitMQ (dentro do Docker o host é `rabbitmq`; fora use localhost:5672)
RABBITMQ_USER=notifications
RABBITMQ_PASSWORD=notifications
RABBITMQ_URL=amqp://notifications:notifications@rabbitmq:5672
NOTIFICATIONS_QUEUE=notifications.book-created
